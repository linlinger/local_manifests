<?xml version="1.0" encoding="UTF-8"?>
<manifest>
 <!--Remotes-->
 <remote name="linlinger" fetch="https://github.com/linlinger" />
 <remote name="crd" fetch="https://github.com/crdroidandroid" />
 <remote name="los" fetch="https://github.com/LineageOS" />
 <remote name="crd-gitlab" fetch="https://gitlab.com/crdroidandroid" />
 <remote name="githubmuppets" fetch="https://github.com/TheMuppets" />

 <!-- OnePlus xigua (Ace 2 Pro / PJA110) device tree
      fork: + OplusRefreshRateVendor 集成 (PRODUCT_PACKAGES / privapp 白名单 / sepolicy) -->
 <project path="device/oneplus/xigua" name="android_device_oneplus_xigua" remote="linlinger" revision="17.0" />
 <project path="vendor/oneplus/xigua" name="proprietary_vendor_oneplus_xigua" remote="crd-gitlab" revision="17.0" />

 <!-- OnePlus sm8550 common tree -->
 <project path="device/oneplus/sm8550-common" name="android_device_oneplus_sm8550-common" remote="crd" revision="17.0" />

 <!-- Kernel (fork: + PROC_MAPS_HIDE) -->
 <project path="kernel/oneplus/sm8550" name="android_kernel_oneplus_sm8550" remote="linlinger" revision="17.0" />
 <!-- devicetrees fork 自 crdroidandroid (分支/历史不变, 后续改动走 fork) -->
 <project path="kernel/oneplus/sm8550-devicetrees" name="android_kernel_oneplus_sm8550-devicetrees" remote="linlinger" revision="17.0" />
 <!-- Kernel modules (fork: + recovery 黑屏修复) -->
 <project path="kernel/oneplus/sm8550-modules" name="android_kernel_oneplus_sm8550-modules" remote="linlinger" revision="17.0" />

 <!-- Vendor blobs -->
 <project path="vendor/oneplus/sm8550-common" name="proprietary_vendor_oneplus_sm8550-common" remote="githubmuppets" revision="lineage-24.0" />

 <!-- Hardware -->
 <project path="hardware/oplus" name="android_hardware_oplus" remote="crd" revision="17.0" />
 <project path="hardware/pixelworks/interfaces" name="android_hardware_pixelworks_interfaces" remote="los" revision="lineage-24.0" />
 <!-- Display HAL (fork: + IRIS Dual 单 display 屏幕冻结修复, 基于 lineage-24.0-caf-sm8550)
      注意: LineageOS/android_hardware_qcom_display 这个 name 被 8+ 个 SoC 共用
      (sm8150/sm8250/sm8350/sm8450/sm8750/sm8850...), 必须加 path 精确移除 sm8550
      实例, 否则其他 SoC 的 display hal 也被删, 其 core/intf 兄弟项目会缺依赖 -->
 <remove-project name="LineageOS/android_hardware_qcom_display" path="hardware/qcom-caf/sm8550/display" />
 <project path="hardware/qcom-caf/sm8550/display" name="android_hardware_qcom_display" remote="linlinger" revision="17.0" />
 <project path="vendor/oneplus/ir" name="proprietary_vendor_oneplus_ir" remote="crd-gitlab" revision="17.0" />

 <!-- Dolby (crdroid 全栈: LunarisDolby UI + dms@2.0 blob 一体设计)
      移除 PixelOS 默认的 DolbyAtmos, 其 preinstalled-packages-platform-dolby.xml
      与 LunarisDolby 模块撞名 (soong 解析期冲突)
      vendor 仓库 fork: LunarisDolbyOverlay 去掉 com.crdroid.apps.resources 依赖
      (crdroid 共享 RRO 资源库, PixelOS 树里不存在; overlay res 并未引用它)
      app 仓库 fork: 上游 81ea5c1 把 strings 搬进 com.crdroid.apps.resources
      (本树不存在该模块), revert 见 ef020f7, 走 linlinger/17.0 -->
 <remove-project name="PixelOS-AOSP/android_packages_apps_DolbyAtmos" />
 <project path="packages/apps/LunarisDolby" name="android_packages_apps_LunarisDolby" remote="linlinger" revision="17.0" />
 <project path="vendor/oneplus/dolby" name="proprietary_vendor_oneplus_dolby" remote="linlinger" revision="17.0" />

 <!-- OplusRefreshRate vendor 版刷新率调度 (linlinger 自研, 装入 /vendor/priv-app)
      需在 device.mk 里 PRODUCT_PACKAGES += OplusRefreshRateVendor 才会编译进 ROM -->
 <project path="vendor/oneplus/refreshrate" name="PJA110-RefreshRateVendor" remote="linlinger" revision="main" />

 <!-- OnePlus Camera (com.oplus.camera, ColorOS 提取, 方案 B 精简移植)
      presigned APK → /product/priv-app + 5 条 signature|privileged 白名单,
      算法库 → /product/lib64, 与 LineageOS Aperture 共存
      注意: 不走 manifest (repo checkout 与 LFS 仓库冲突, unsupported checkout
      state), 手动放置:
        git clone https://github.com/linlinger/PJA110-OplusCamera /android/src/PixelOS/vendor/oneplus/opluscamera
      (或直接拷贝文件) -->

</manifest>
